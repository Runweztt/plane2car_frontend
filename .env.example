



# ================================================================
#  Plane to Car — Frontend Environment Variables
#  Copy this file to .env.local for local dev.
#  On Vercel, add these in: Project Settings → Environment Variables
#  Never commit your .env.local file to git.
# ================================================================

# ----------------------------------------------------------------
# BACKEND API URL
# Local dev:          http://localhost:5000/api
# Hostinger VPS:      https://api.yourdomain.com/api
# Vercel backend:     https://your-backend.vercel.app/api
#
# ⚠️  Must start with VITE_ for Vite to expose it to the browser
# ----------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
